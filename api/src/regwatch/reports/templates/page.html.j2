{#- One report page set (M7.2). Autoescape is on for every value: layout text and captured item
    fields are hostile. Nothing here is marked safe, and no URL reaches src or CSS. Text inside
    <style> (header and footer) goes through css_text, which hex-escapes all but letters,
    digits and spaces, since HTML escaping means nothing there. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{#- For PDF and email, where no response header applies (M7.2 review, the M8 list). -#}
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>{{ title }}</title>
<style>
@page { size: {{ page_size }} {{ orientation }}; margin: 18mm 16mm 20mm;
{%- if header %} @top-left { content: "{{ header | css_text }}"; font-size: 9pt; color: #52514e; }{% endif %}
{%- if footer %} @bottom-left { content: "{{ footer | css_text }}"; font-size: 9pt; color: #52514e; }{% endif %}
{%- if page_numbers %} @bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 9pt; color: #52514e; }{% endif %}
}
body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 10.5pt; color: #0b0b0b; margin: 0; }
h1 { font-size: 18pt; margin: 0 0 8pt; } h2 { font-size: 14pt; margin: 14pt 0 6pt; } h3 { font-size: 12pt; margin: 12pt 0 4pt; }
p.text { white-space: pre-line; margin: 0 0 8pt; }
table { border-collapse: collapse; width: 100%; margin: 6pt 0 12pt; }
caption { text-align: left; font-weight: 600; margin-bottom: 4pt; }
th, td { text-align: left; vertical-align: top; padding: 3pt 5pt; border-bottom: 0.5pt solid #c3c2b7; }
th { font-weight: 600; } tr { break-inside: avoid; }
.muted { color: #52514e; } .page-break { break-after: page; }
.markings { border-top: 0.5pt solid #c3c2b7; margin-top: 12pt; padding-top: 6pt; font-size: 9pt; color: #52514e; }
.field dt { font-weight: 600; } .field dd { margin: 0 0 6pt; }
</style>
</head>
<body>
{%- if title %}<h1>{{ title }}</h1>{% endif %}
{%- if date %}<p class="muted">Prepared {{ prepared }}</p>{% endif %}
{%- for block in blocks %}
{%- set p = block.props %}
{%- if block.type == "Heading" %}
<h{{ p.level + 1 }}>{{ p.text }}</h{{ p.level + 1 }}>
{%- elif block.type == "Paragraph" %}
<p class="text">{{ p.text }}</p>
{%- elif block.type == "FieldValue" %}
<dl class="field"><dt>{{ p.label or block.label }}</dt><dd>{{ block.value or "—" }}</dd></dl>
{%- elif block.type == "ItemsTable" %}
<table>
{%- if p.caption %}<caption>{{ p.caption }}</caption>{% endif %}
<thead><tr>{% for c in block.columns %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in block.rows %}
<tr>{% for cell in row %}<td>{% if cell.href %}<a href="{{ cell.href }}" rel="noopener noreferrer nofollow">{{ cell.text }}</a>{% else %}{{ cell.text }}{% endif %}</td>{% endfor %}</tr>
{%- else %}
<tr><td colspan="{{ block.columns | length }}" class="muted">No items match.</td></tr>
{%- endfor %}
</tbody>
</table>
{%- elif block.type == "ChangeList" %}
{%- if p.title %}<h3>{{ p.title }}</h3>{% endif %}
<table>
<thead><tr><th scope="col">When</th><th scope="col">Item</th><th scope="col">Change</th><th scope="col">Severity</th></tr></thead>
<tbody>
{%- for c in block.changes %}
<tr><td>{{ c.when }}</td><td>{{ c.title }}</td><td>{{ c.kind }}</td><td>{{ c.severity }}</td></tr>
{%- else %}
<tr><td colspan="4" class="muted">No changes.</td></tr>
{%- endfor %}
</tbody>
</table>
{%- elif block.type == "JurisdictionSummary" %}
{%- if p.title %}<h3>{{ p.title }}</h3>{% endif %}
<table>
<thead><tr><th scope="col">Jurisdiction</th><th scope="col">Items</th><th scope="col">Highest severity</th></tr></thead>
<tbody>
{%- for j in block.places %}
<tr><td>{{ j.name }}</td><td>{{ j.count }}</td><td>{{ j.severity }}</td></tr>
{%- else %}
<tr><td colspan="3" class="muted">No items match.</td></tr>
{%- endfor %}
</tbody>
</table>
{%- elif block.type == "StatusMatrix" %}
{%- if p.title %}<h3>{{ p.title }}</h3>{% endif %}
<table>
<thead><tr><th scope="col">Jurisdiction</th>{% for s in block.matrix.statuses %}<th scope="col">{{ s }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for r in block.matrix.rows %}
<tr><th scope="row">{{ r.name }}</th>{% for c in r.counts %}<td>{{ c }}</td>{% endfor %}</tr>
{%- else %}
<tr><td colspan="{{ block.matrix.statuses | length + 1 }}" class="muted">No items match.</td></tr>
{%- endfor %}
</tbody>
</table>
{%- elif block.type == "SourceHealth" %}
{%- if p.title %}<h3>{{ p.title }}</h3>{% endif %}
{%- if block.sources is none %}
<p class="muted">Source health is shown to readers of sources only.</p>
{%- else %}
<table>
<thead><tr><th scope="col">Source</th><th scope="col">Health</th><th scope="col">State</th><th scope="col">Failures in a row</th></tr></thead>
<tbody>
{%- for x in block.sources %}
<tr><td>{{ x.name }}</td><td>{{ x.health }}</td><td>{{ x.state }}</td><td>{{ x.failures }}</td></tr>
{%- endfor %}
</tbody>
</table>
{%- endif %}
{%- elif block.type == "PageBreak" %}
<div class="page-break"></div>
{%- elif block.type == "LegalMarkings" %}
<div class="markings">
{%- if company %}<p>{{ company }}{% if address %}, {{ address }}{% endif %}</p>{% endif %}
{%- if markings %}<p>{{ markings }}</p>{% endif %}
</div>
{%- endif %}
{%- endfor %}
</body>
</html>
