# Pinned versions of the scanning tools used by `make licenses`, `make security` and
# .github/workflows/ci.yml; sourced by those scripts and CI steps. Plain KEY=value lines only.
# Every tool here has a row in docs/03-architecture.md 3.6. Images are pinned by digest.
PIP_LICENSES_VERSION=5.5.5
PIP_AUDIT_VERSION=2.10.1
BANDIT_VERSION=1.9.4
SEMGREP_VERSION=1.183.0
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
# Fallback when the host cannot run the semgrep wheel (it needs glibc 2.35 or later).
SEMGREP_IMAGE=semgrep/semgrep:1.183.0@sha256:2e45517a85e13a9cca14a2a00df6bb48affd66b8ebfae1b0991cd57578362fb0
