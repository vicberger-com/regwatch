{
  "uid": "regwatch-overview",
  "title": "regwatch overview",
  "tags": [
    "regwatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Capture success rate, 24 h",
      "description": "Successful and partial runs over all finished runs in the last 24 hours. Shows 'No runs in 24 h' rather than a rate when nothing ran.",
      "datasource": {
        "type": "prometheus",
        "uid": "regwatch-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(regwatch_capture_runs_24h{status=~\"success|partial\"}) or vector(0)) / clamp_min(sum(regwatch_capture_runs_24h), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "regwatch-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "noValue": "No runs in 24 h"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sources unhealthy for 24 h",
      "description": "The SourceUnhealthyFor24Hours alert fires when this is above zero for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "regwatch-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "regwatch_sources_unhealthy_24h",
          "datasource": {
            "type": "prometheus",
            "uid": "regwatch-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Outputs failed, 24 h",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "regwatch-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(regwatch_outputs_failed_24h)",
          "datasource": {
            "type": "prometheus",
            "uid": "regwatch-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Items changed, last hour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "regwatch-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "regwatch_items_changed_1h",
          "datasource": {
            "type": "prometheus",
            "uid": "regwatch-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
