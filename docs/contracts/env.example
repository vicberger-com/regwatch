# Copy to deploy/.env for development. Every variable the application reads. Required ones have no default.
# Never commit a filled .env.

# --- core (required) ---
REGWATCH_SECRET_KEY=            # 64 random hex chars; signs sessions and tokens. Rotate via REGWATCH_SECRET_KEY_PREVIOUS
REGWATCH_SECRET_KEY_PREVIOUS=   # optional, dual-key window during rotation
REGWATCH_DATABASE_URL=          # postgresql+psycopg://regwatch_api:password@db:5432/regwatch; the API login, a member of regwatch_app, never the owner (BL-61)
REGWATCH_MIGRATION_DATABASE_URL=   # optional; owner login for migrations (make migrate), for example postgresql+psycopg://regwatch:password@db:5432/regwatch; defaults to REGWATCH_DATABASE_URL
REGWATCH_QUEUE_URL=             # valkey://regwatch:<password>@queue:6379/0; Valkey requires the password (BL-90 (a))
REGWATCH_OBJECT_STORE_PATH=/data/objectstore   # local path; or set REGWATCH_OBJECT_STORE_S3_* for S3-compatible storage
REGWATCH_BASE_URL=              # https://regwatch.example.com (used in links and emails)

# --- core (optional) ---
REGWATCH_ENV=development        # development | production | test
REGWATCH_LOG_LEVEL=INFO
REGWATCH_TRUSTED_PROXIES=10.89.0.2/32   # CIDRs allowed to set X-Forwarded-*: exactly the proxy (10.89.0.2 in deploy/compose.yaml); a wider range lets other containers forge client addresses, a wrong one makes every client appear as the proxy (BL-73)
REGWATCH_SESSION_COOKIE_NAME=rw_session
REGWATCH_OBJECT_STORE_S3_ENDPOINT=
REGWATCH_OBJECT_STORE_S3_BUCKET=
REGWATCH_OBJECT_STORE_S3_ACCESS_KEY=
REGWATCH_OBJECT_STORE_S3_SECRET_KEY=

# --- email (required when outputs.email is on) ---
REGWATCH_SMTP_HOST=mailpit
REGWATCH_SMTP_PORT=1025
REGWATCH_SMTP_USERNAME=
REGWATCH_SMTP_PASSWORD=
REGWATCH_SMTP_STARTTLS=false
REGWATCH_SMTP_FROM=regwatch@example.com

# --- sidecar services ---
REGWATCH_PDF_URL=http://pdf:3000               # Gotenberg
REGWATCH_SEARCH_URL=http://search:8080         # SearXNG, when search.provider=searxng
REGWATCH_SEARCH_API_KEY=                       # commercial provider, when search.provider=http
REGWATCH_SEARCH_API_URL=
REGWATCH_TRANSLATE_URL=http://translate:5000   # LibreTranslate or Argos service, when translation.provider=libretranslate
REGWATCH_TRANSLATE_API_KEY=                    # hosted provider, when translation.provider=http
REGWATCH_TRANSLATE_API_URL=
REGWATCH_INDEX_URL=                            # OpenSearch (ADR-0011, CP-22), https://index:9200 when the index profile runs; unset: PostgreSQL search
REGWATCH_INDEX_USER=regwatch_search            # regwatch_search (api, read only) or regwatch_indexer (worker)
REGWATCH_INDEX_PASSWORD=                       # written to deploy/index.env by scripts/index-setup.sh
REGWATCH_INDEX_CA_B64=                         # the stack's CA certificate, base64 PEM (scripts/index-setup.sh)
REGWATCH_MODEL_URL=http://ollama:11434         # when classification.model_provider=ollama
REGWATCH_MODEL_API_KEY=                        # when classification.model_provider=http
REGWATCH_MODEL_API_URL=
REGWATCH_PRINT_BRIDGE_URL=http://print-bridge:7000

# --- identity (M1b) ---
REGWATCH_OIDC_ISSUER=
REGWATCH_OIDC_CLIENT_ID=
REGWATCH_OIDC_CLIENT_SECRET=

# --- observability ---
REGWATCH_METRICS_ENABLED=true
REGWATCH_OTEL_EXPORTER_OTLP_ENDPOINT=
# CP-33: allow the `print-test` Compose profile's ippeveprinter as a printer (development and QA only)
REGWATCH_PRINT_TEST_PRINTER=false
